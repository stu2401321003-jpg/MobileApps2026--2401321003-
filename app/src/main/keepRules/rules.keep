# Add project specific R8 rules here.
# AGP will combine all keep rule files in src/main/keepRules to pass to R8
#
# For more details, see
#   https://d.android.com/r/tools/r8/keep-rules

# Gson попълва DTO класовете по имената на полетата (чрез reflection).
# Без това правило R8 ще преименува полетата в release APK-то и времето няма да се зарежда.
-keep class com.example.whattowear_project.weather.dto.** { *; }
