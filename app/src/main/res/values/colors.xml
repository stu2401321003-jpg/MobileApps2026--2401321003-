<?xml version="1.0" encoding="utf-8"?>
<!--
    Цветова палитра - СВЕТЛА тема.
    Идея: „небе“ (синьо), „слънце“ (корал), „природа“ (зелено).
    Тъмните варианти са в values-night/colors.xml със същите имена.
-->
<resources>
    <color name="black">#FF000000</color>
    <color name="white">#FFFFFFFF</color>

    <!-- Основен: небесно синьо -->
    <color name="primary">#2D5DA1</color>
    <color name="on_primary">#FFFFFF</color>
    <color name="primary_container">#D7E3FF</color>
    <color name="on_primary_container">#001B3F</color>

    <!-- Вторичен: топъл корал -->
    <color name="secondary">#9C4323</color>
    <color name="on_secondary">#FFFFFF</color>
    <color name="secondary_container">#FFDBCF</color>
    <color name="on_secondary_container">#3A0B00</color>

    <!-- Третичен: свежо зелено -->
    <color name="tertiary">#2B6A46</color>
    <color name="on_tertiary">#FFFFFF</color>
    <color name="tertiary_container">#B0F1C3</color>
    <color name="on_tertiary_container">#00210F</color>

    <color name="error">#BA1A1A</color>
    <color name="on_error">#FFFFFF</color>
    <color name="error_container">#FFDAD6</color>
    <color name="on_error_container">#410002</color>

    <!-- Фонове и повърхности -->
    <color name="background">#F8F9FF</color>
    <color name="on_background">#191C20</color>
    <color name="surface">#F8F9FF</color>
    <color name="on_surface">#191C20</color>
    <color name="surface_variant">#E0E2EC</color>
    <color name="on_surface_variant">#43474E</color>
    <color name="outline">#74777F</color>
    <color name="outline_variant">#C4C6CF</color>
    <color name="surface_container_lowest">#FFFFFF</color>
    <color name="surface_container_low">#F2F3FA</color>
    <color name="surface_container">#ECEEF4</color>
    <color name="surface_container_high">#E6E8EE</color>
    <color name="surface_container_highest">#E1E2E9</color>

    <!-- Цвят на фона на картата според типа дреха (когато няма снимка) -->
    <color name="type_top">#D7E3FF</color>
    <color name="type_bottom">#DDE1F9</color>
    <color name="type_jacket">#FFDBCF</color>
    <color name="type_shoes">#B0F1C3</color>
    <color name="type_accessory">#FCE1A8</color>
    <color name="on_type">#1F2A3D</color>

    <!-- Полупрозрачно бяло върху цветната карта за времето (еднакво в двете теми) -->
    <color name="hero_overlay">#33FFFFFF</color>
    <color name="hero_text_secondary">#D9FFFFFF</color>
</resources>
