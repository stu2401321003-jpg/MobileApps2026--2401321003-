<?xml version="1.0" encoding="utf-8"?>
<!-- Начало - хоризонтално: времето ВЛЯВО, тоалетът ВДЯСНО (всяка половина със собствен скрол). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="horizontal"
    tools:context=".ui.home.HomeFragment">

    <androidx.core.widget.NestedScrollView
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1">

        <include
            android:id="@+id/weather"
            layout="@layout/view_home_weather"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="16dp" />
    </androidx.core.widget.NestedScrollView>

    <androidx.core.widget.NestedScrollView
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1">

        <!-- Отрицателният горен отстъп изравнява заглавието с картата вляво. -->
        <include
            android:id="@+id/outfit"
            layout="@layout/view_home_outfit"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:layout_marginTop="-4dp"
            android:layout_marginEnd="16dp"
            android:layout_marginBottom="16dp" />
    </androidx.core.widget.NestedScrollView>
</LinearLayout>
