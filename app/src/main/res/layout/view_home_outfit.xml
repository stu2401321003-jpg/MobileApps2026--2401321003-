<?xml version="1.0" encoding="utf-8"?>
<!-- Секцията „Какво да облечеш днес“ (вмъква се с <include>). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <TextView
        android:id="@+id/text_outfit_section"
        style="@style/TextAppearance.WhatToWear.SectionTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="4dp"
        android:text="@string/home_outfit_title" />

    <!-- Готов тоалет -->
    <LinearLayout
        android:id="@+id/layout_outfit"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:visibility="gone"
        tools:visibility="visible">

        <TextView
            android:id="@+id/text_outfit_headline"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:textAppearance="?attr/textAppearanceTitleLarge"
            android:textColor="?attr/colorOnSurface"
            tools:text="Днес е 3° и вали." />

        <TextView
            android:id="@+id/text_outfit_summary"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:layout_marginTop="2dp"
            android:layout_marginBottom="12dp"
            android:textAppearance="?attr/textAppearanceTitleMedium"
            android:textColor="?attr/colorPrimary"
            android:textStyle="bold"
            tools:text="Облечи: Черно яке + Дънки + Ботуши + Чадър" />

        <!-- Картите на дрехите (добавят се от кода) -->
        <LinearLayout
            android:id="@+id/container_picks"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />

        <!-- Съвети: какво липсва в гардероба (добавят се от кода) -->
        <LinearLayout
            android:id="@+id/container_tips"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />
    </LinearLayout>

    <!-- Съобщение: „Първо ни трябва времето“ / „Гардеробът е празен“ -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/card_outfit_message"
        style="@style/Widget.WhatToWear.FormCard"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:background="@drawable/bg_empty_circle"
                    android:importantForAccessibility="no"
                    android:padding="12dp"
                    android:src="@drawable/ic_wardrobe"
                    app:tint="?attr/colorOnPrimaryContainer" />

                <TextView
                    android:id="@+id/text_outfit_message"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="14dp"
                    android:layout_weight="1"
                    android:textAppearance="?attr/textAppearanceBodyMedium"
                    android:textColor="?attr/colorOnSurfaceVariant"
                    tools:text="@string/outfit_waiting_for_weather" />
            </LinearLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/button_go_to_wardrobe"
                style="@style/Widget.Material3.Button.TonalButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="end"
                android:layout_marginTop="8dp"
                android:text="@string/outfit_go_to_wardrobe"
                android:visibility="gone"
                app:icon="@drawable/ic_add"
                tools:visibility="visible" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>
</LinearLayout>
