<?xml version="1.0" encoding="utf-8"?>
<!-- Една дреха от препоръчания тоалет: малка снимка + име + вид/диапазон + причина. -->
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    style="@style/Widget.WhatToWear.FormCard"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="8dp"
    android:clickable="true"
    android:focusable="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="10dp">

        <!-- Малка снимка (или цветен фон + икона) -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="64dp"
            android:layout_height="64dp"
            app:cardElevation="0dp"
            app:shapeAppearance="?attr/shapeAppearanceCornerMedium"
            app:strokeWidth="0dp">

            <FrameLayout
                android:id="@+id/thumb_container"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                tools:background="@color/type_jacket">

                <ImageView
                    android:id="@+id/thumb_type_icon"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:layout_gravity="center"
                    android:importantForAccessibility="no"
                    app:tint="@color/on_type"
                    tools:src="@drawable/ic_type_jacket" />

                <ImageView
                    android:id="@+id/thumb_photo"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:importantForAccessibility="no"
                    android:scaleType="centerCrop"
                    android:visibility="gone" />
            </FrameLayout>
        </com.google.android.material.card.MaterialCardView>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/text_pick_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:textAppearance="?attr/textAppearanceTitleSmall"
                android:textColor="?attr/colorOnSurface"
                android:textStyle="bold"
                tools:text="Черно зимно яке" />

            <TextView
                android:id="@+id/text_pick_details"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textAppearance="?attr/textAppearanceBodySmall"
                android:textColor="?attr/colorOnSurfaceVariant"
                tools:text="Палто · -20° … 8°" />

            <!-- Причина (само при специално правило: студ / дъжд) -->
            <TextView
                android:id="@+id/text_pick_reason"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:drawablePadding="4dp"
                android:gravity="center_vertical"
                android:textAppearance="?attr/textAppearanceLabelMedium"
                android:textColor="?attr/colorSecondary"
                android:visibility="gone"
                app:drawableTint="?attr/colorSecondary"
                tools:drawableStart="@drawable/ic_snowflake_small"
                tools:text="Под 5° якето е задължително"
                tools:visibility="visible" />
        </LinearLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
