<?xml version="1.0" encoding="utf-8"?>
<!--
    Информацията за дрехата (без снимката): име, етикети, температура, бутони.
    Отделен файл, за да я ползват и портретният, и хоризонталният layout (<include>).
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <TextView
        android:id="@+id/text_name"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textAppearance="?attr/textAppearanceHeadlineSmall"
        android:textColor="?attr/colorOnSurface"
        android:textStyle="bold"
        tools:text="Черно зимно яке" />

    <!-- Етикети: вид + „става за дъжд“ -->
    <com.google.android.material.chip.ChipGroup
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp">

        <com.google.android.material.chip.Chip
            android:id="@+id/chip_kind"
            style="@style/Widget.WhatToWear.Chip.Info"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            tools:chipIcon="@drawable/ic_type_jacket"
            tools:text="Палто" />

        <com.google.android.material.chip.Chip
            android:id="@+id/chip_waterproof"
            style="@style/Widget.WhatToWear.Chip.Info"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/waterproof"
            app:chipIcon="@drawable/ic_water_drop" />
    </com.google.android.material.chip.ChipGroup>

    <!-- Температура -->
    <com.google.android.material.card.MaterialCardView
        style="@style/Widget.WhatToWear.FormCard"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/detail_temp_title"
                android:textAppearance="?attr/textAppearanceLabelLarge"
                android:textColor="?attr/colorOnSurfaceVariant" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_thermometer"
                    app:tint="?attr/colorSecondary" />

                <TextView
                    android:id="@+id/text_temp_range"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:textAppearance="?attr/textAppearanceHeadlineMedium"
                    android:textColor="?attr/colorSecondary"
                    android:textStyle="bold"
                    tools:text="-20° … 8°" />
            </LinearLayout>

            <!-- Скала -30° … 40°: [преди][диапазон][след]. Теглата се задават от кода. -->
            <LinearLayout
                android:id="@+id/temp_bar"
                android:layout_width="match_parent"
                android:layout_height="12dp"
                android:layout_marginTop="14dp"
                android:background="@drawable/bg_temp_track"
                android:orientation="horizontal">

                <View
                    android:id="@+id/temp_bar_before"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="10" />

                <View
                    android:id="@+id/temp_bar_range"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="28"
                    android:background="@drawable/bg_temp_range" />

                <View
                    android:id="@+id/temp_bar_after"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="32" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/text_scale_min"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:textAppearance="?attr/textAppearanceLabelSmall"
                    android:textColor="?attr/colorOnSurfaceVariant"
                    tools:text="-30°" />

                <TextView
                    android:id="@+id/text_scale_max"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textAppearance="?attr/textAppearanceLabelSmall"
                    android:textColor="?attr/colorOnSurfaceVariant"
                    tools:text="40°" />
            </LinearLayout>

            <TextView
                android:id="@+id/text_temp_description"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:textAppearance="?attr/textAppearanceBodyMedium"
                android:textColor="?attr/colorOnSurfaceVariant"
                tools:text="Ще я предложим, когато навън е между -20° и 8°." />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- Бутони -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:orientation="horizontal">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/button_edit"
            android:layout_width="0dp"
            android:layout_height="56dp"
            android:layout_marginEnd="6dp"
            android:layout_weight="1"
            android:text="@string/detail_edit"
            app:icon="@drawable/ic_edit"
            app:iconGravity="textStart" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/button_delete"
            style="@style/Widget.WhatToWear.Button.Danger"
            android:layout_width="0dp"
            android:layout_height="56dp"
            android:layout_marginStart="6dp"
            android:layout_weight="1"
            android:text="@string/detail_delete"
            app:icon="@drawable/ic_delete"
            app:iconGravity="textStart" />
    </LinearLayout>
</LinearLayout>
