<?xml version="1.0" encoding="utf-8"?>
<!-- Форма „Нова дреха“: име, тип, вид, температура, дъжд. -->
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/scroll_form"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipToPadding="false"
    tools:context=".ui.add.AddClothingFragment">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="20dp"
        android:paddingTop="8dp"
        android:paddingBottom="24dp">

        <!-- 1. Име -->
        <TextView
            style="@style/TextAppearance.WhatToWear.SectionTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/form_section_name" />

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/input_layout_name"
            style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/form_name_hint"
            app:counterEnabled="true"
            app:counterMaxLength="40"
            app:startIconDrawable="@drawable/ic_wardrobe">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/edit_name"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:imeOptions="actionDone"
                android:inputType="textCapSentences"
                android:maxLines="1" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- 2. Тип -->
        <TextView
            style="@style/TextAppearance.WhatToWear.SectionTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/form_section_type" />

        <com.google.android.material.chip.ChipGroup
            android:id="@+id/chip_group_type"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:singleSelection="true">

            <com.google.android.material.chip.Chip
                android:id="@+id/chip_type_top"
                style="@style/Widget.WhatToWear.Chip.FilterWithIcon"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/type_top"
                app:chipIcon="@drawable/ic_type_top" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chip_type_bottom"
                style="@style/Widget.WhatToWear.Chip.FilterWithIcon"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/type_bottom"
                app:chipIcon="@drawable/ic_type_bottom" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chip_type_jacket"
                style="@style/Widget.WhatToWear.Chip.FilterWithIcon"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/type_jacket"
                app:chipIcon="@drawable/ic_type_jacket" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chip_type_shoes"
                style="@style/Widget.WhatToWear.Chip.FilterWithIcon"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/type_shoes"
                app:chipIcon="@drawable/ic_type_shoes" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chip_type_accessory"
                style="@style/Widget.WhatToWear.Chip.FilterWithIcon"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/type_accessory"
                app:chipIcon="@drawable/ic_type_accessory" />
        </com.google.android.material.chip.ChipGroup>

        <TextView
            android:id="@+id/text_type_error"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:text="@string/form_error_type"
            android:textAppearance="?attr/textAppearanceBodySmall"
            android:textColor="?attr/colorError"
            android:visibility="gone"
            tools:visibility="visible" />

        <!-- 3. Вид (подвид) - показва се след избор на тип -->
        <LinearLayout
            android:id="@+id/section_subtype"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone"
            tools:visibility="visible">

            <TextView
                style="@style/TextAppearance.WhatToWear.SectionTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/form_section_subtype" />

            <com.google.android.material.chip.ChipGroup
                android:id="@+id/chip_group_subtype"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:chipSpacingHorizontal="6dp"
                app:singleSelection="true" />
        </LinearLayout>

        <!-- 4. Температура -->
        <TextView
            style="@style/TextAppearance.WhatToWear.SectionTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/form_section_temp" />

        <com.google.android.material.card.MaterialCardView
            style="@style/Widget.WhatToWear.FormCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:layout_width="28dp"
                        android:layout_height="28dp"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_thermometer"
                        app:tint="?attr/colorSecondary" />

                    <TextView
                        android:id="@+id/text_temp_range"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:textAppearance="?attr/textAppearanceHeadlineMedium"
                        android:textColor="?attr/colorSecondary"
                        android:textStyle="bold"
                        tools:text="5° … 20°" />
                </LinearLayout>

                <com.google.android.material.slider.RangeSlider
                    android:id="@+id/slider_temp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:stepSize="1"
                    android:valueFrom="-30"
                    android:valueTo="40"
                    app:values="@array/default_temp_range" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/form_temp_hint"
                    android:textAppearance="?attr/textAppearanceBodySmall"
                    android:textColor="?attr/colorOnSurfaceVariant" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- 5. Става за дъжд -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/card_waterproof"
            style="@style/Widget.WhatToWear.FormCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:clickable="true"
            android:focusable="true">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="16dp">

                <ImageView
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:background="@drawable/bg_empty_circle"
                    android:importantForAccessibility="no"
                    android:padding="9dp"
                    android:src="@drawable/ic_water_drop"
                    app:tint="?attr/colorOnPrimaryContainer" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="14dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/waterproof"
                        android:textAppearance="?attr/textAppearanceTitleMedium"
                        android:textColor="?attr/colorOnSurface" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/form_waterproof_hint"
                        android:textAppearance="?attr/textAppearanceBodySmall"
                        android:textColor="?attr/colorOnSurfaceVariant" />
                </LinearLayout>

                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/switch_waterproof"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- 6. Запази -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/button_save"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:layout_marginTop="28dp"
            android:text="@string/form_save"
            android:textAppearance="?attr/textAppearanceTitleMedium"
            app:icon="@drawable/ic_check"
            app:iconGravity="textStart" />
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
